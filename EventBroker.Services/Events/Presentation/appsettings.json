{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=events-db;Port=5432;Database=events_db;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "validIssuer": "EventBroker.API",
    "validAudience": "http://localhost:9999",
    "expiresMinutes": 30,
    "secret": "AmazingEventBrokerApiSecretKeyFor100millionsUsers"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "bookings-service-group"
  },
  "Redis": {
    "EndPoint": "localhost:6379",
    "Password": "",
    "ConnectionString": "localhost:6379",
    "EventTtlMinutes": 5,
    "TopEventsTtlMinutes": 10,
    "ConnectTimeout": 5000,
    "SyncTimeout": 3000,
    "AbortOnConnectFail": false
  }
}
